{
  "name": "studiopod-design",
  "version": "0.1.0",
  "private": true,
  "description": "StudioPOD Design — the workspace root. Publishes @jheavner95/design (packages/design) and hosts the documentation product (apps/docs).",
  "license": "MIT",
  "author": "StudioPOD",
  "homepage": "https://github.com/jheavner95/studiopod-design#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jheavner95/studiopod-design.git"
  },
  "bugs": {
    "url": "https://github.com/jheavner95/studiopod-design/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @studiopod/docs",
    "start": "npm run start --workspace @studiopod/docs",
    "build": "npm run package:build && npm run docs:build",
    "package:build": "npm run build --workspace @jheavner95/design",
    "package:typecheck": "npm run typecheck --workspace @jheavner95/design",
    "package:api-check": "npm run api-check --workspace @jheavner95/design",
    "package:css-check": "npm run css-check --workspace @jheavner95/design",
    "package:framework-check": "npm run framework-check --workspace @jheavner95/design",
    "package:client-boundaries-check": "npm run client-boundaries-check --workspace @jheavner95/design",
    "package:exports-check": "npm run exports-check --workspace @jheavner95/design",
    "package:identity-check": "npm run identity-check --workspace @jheavner95/design",
    "package:verify": "npm run verify --workspace @jheavner95/design",
    "package:pack": "npm pack ./packages/design --pack-destination ./packages/design",
    "package:inspect": "tar -tzf packages/design/studiopod-design-[0-9]*.tgz",
    "docs:build": "npm run build --workspace @studiopod/docs",
    "docs:typecheck": "npm run typecheck --workspace @studiopod/docs",
    "docs:coverage": "node tooling/docs-coverage.mjs",
    "typecheck": "npm run package:typecheck && npm run docs:typecheck",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:typecheck": "tsc --noEmit -p packages/design/tsconfig.test.json && tsc --noEmit -p apps/docs/tsconfig.test.json && tsc --noEmit -p tsconfig.json",
    "test:e2e": "npm run test:e2e --workspace @studiopod/docs",
    "test:e2e:update": "npm run test:e2e:update --workspace @studiopod/docs",
    "boundary-check": "node tooling/boundary-check.mjs",
    "certification:report": "node tooling/certification-report.mjs",
    "token:report": "node tooling/token-report.mjs",
    "token:bridge": "node tooling/generators/generate-tokens-from-foundation.mjs",
    "token:bridge-check": "node tooling/generators/generate-tokens-from-foundation.mjs --check",
    "verify:fast": "node tooling/verify.mjs fast",
    "verify": "node tooling/verify.mjs default",
    "verify:full": "node tooling/verify.mjs full",
    "release:verify": "npm run verify:full"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@jheavner95/foundation": "0.4.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
