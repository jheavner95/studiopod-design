{
  // Workspace-root configuration. It deliberately compiles nothing: each
  // workspace owns its own tsconfig, and there is no repository-wide "@"
  // alias any more — "@" means packages/design/src inside the library and
  // apps/docs/src inside the documentation application. A root path mapping
  // spanning both is what let the published package compile the
  // documentation site before DH-2.
  //
  //   packages/design/tsconfig.json   the published library
  //   apps/docs/tsconfig.json         the documentation application
  //
  // This file exists so editors and ESLint have a root to resolve compiler
  // defaults from, and to typecheck repository tooling.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["tooling/**/*.ts"],
  "exclude": ["node_modules", "**/dist/**", "**/.next/**"]
}
